# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# W.Vetro API (somente no servidor; nunca commitar valores reais)
# Configure WVETRO_LICENSE_ID, WVETRO_USERNAME e WVETRO_PASSWORD na Vercel (Preview + Production).
# Depois de alterar essas variáveis na Vercel, gere um novo deployment para aplicar os valores.
WVETRO_BASE_URL=https://api.wvetro.com.br/wvetro/rest/api/v2
WVETRO_LICENSE_ID=
WVETRO_USERNAME=
WVETRO_PASSWORD=
WVETRO_EMPRESA_SLUG=esquadrifacio

# WhatsApp Business Platform / Meta Cloud API (somente servidor)
WHATSAPP_BUSINESS_PHONE_E164=5517996355667
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Atlas AI runtime — política zero-custo
# Ordem padrão: banco/regras internas -> OpenCode + Ollama local -> OpenCode + FreeLLMAPI.
# Provedores pagos ficam bloqueados por padrão. Só altere ATLAS_AI_FORCE_ZERO_COST para false
# se houver uma decisão explícita de permitir custo (não recomendado para a operação normal).
ATLAS_AI_FORCE_ZERO_COST=true
ATLAS_AI_ALLOW_PAID_PROVIDERS=false

# OpenCode: em produção o Atlas pode descobrir o gateway pela tabela backend-only
# ai_runtime_endpoints (chave opencode_gateway) e autenticar com o JWT do usuário.
OPENCODE_BASE_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_AGENT=atlas-comercial
OPENCODE_TRY_LOCAL=true
OPENCODE_LOCAL_PROVIDER_ID=ollama
OPENCODE_LOCAL_MODEL_ID=llama3.1
OLLAMA_DEFAULT_MODEL=llama3.1
OPENCODE_PROVIDER_ID=freellmapi
OPENCODE_MODEL_ID=free-router
OPENCODE_TIMEOUT_MS=55000
ATLAS_AI_RUNTIME_ALLOWED_HOST=

# Áudio gratuito — servidor local OpenAI-compatible (faster-whisper / whisper.cpp).
# Também pode ser registrado em ai_runtime_endpoints com chave whisper_gateway.
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_MS=120000

# Imagem gratuita — Stable Diffusion WebUI/Forge local.
# Também pode ser registrado em ai_runtime_endpoints com chave image_gateway.
SD_WEBUI_BASE_URL=
LOCAL_IMAGE_MODEL=stable-diffusion-local
LOCAL_IMAGE_WIDTH=1024
LOCAL_IMAGE_HEIGHT=1024
LOCAL_IMAGE_STEPS=20
LOCAL_IMAGE_TIMEOUT_MS=180000
