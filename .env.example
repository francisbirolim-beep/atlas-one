# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# W.Vetro API (somente no servidor; nunca commitar valores reais)
# Configure WVETRO_LICENSE_ID, WVETRO_USERNAME e WVETRO_PASSWORD na Vercel (Preview + Production).
# Depois de alterar essas variáveis na Vercel, gere um novo deployment para aplicar os valores.
WVETRO_BASE_URL=https://api.wvetro.com.br/wvetro/rest/api/v2
WVETRO_LICENSE_ID=
WVETRO_USERNAME=
WVETRO_PASSWORD=


# IA Comercial — OpenCode + FreeLLMAPI
# O Atlas chama apenas o servidor OpenCode. O FreeLLMAPI permanece atrás dele.
# Nunca commitar valores reais. Configure estes valores na Vercel.
OPENCODE_BASE_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_AGENT=atlas-comercial
OPENCODE_PROVIDER_ID=freellmapi
OPENCODE_MODEL_ID=auto
OPENCODE_TIMEOUT_MS=55000
