{
  "name": "atlas-one",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:lan": "next dev -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run build",
    "vercel:preview": "bash scripts/vercel-preview.sh",
    "vercel:prod": "bash scripts/vercel-prod.sh",
    "release:check": "bash scripts/release-check.sh preview",
    "test:wvetro-comparador": "npx -y tsx scripts/test-wvetro-comparador.ts",
    "test:cotacao-ia": "node scripts/test-cotacao-analise.cjs",
    "test:venda-cmv": "node scripts/test-venda-cmv-regras.cjs",
    "test:venda-cmv-revisao": "node scripts/test-venda-cmv-revisao.cjs",
    "test:cmv-exclusao": "node scripts/test-cmv-excluir-lancamento.cjs",
    "test:cmv-pesos": "node scripts/test-cmv-peso-recebimento.cjs",
    "test:cmv-destino": "node scripts/test-cmv-destino.cjs",
    "test:cmv-wvetro-valores": "node scripts/test-cmv-perfil-previsao.cjs",
    "test:venda-fluxo": "node scripts/test-venda-fluxo-resumo.cjs",
    "test:kanban-conciliacao": "node scripts/test-kanban-conciliacao.cjs",
    "test:producao-medicao": "node scripts/test-producao-vinculo-medicao.cjs && node scripts/test-producao-medicao-elegibilidade.cjs",
    "test:liberacao-op": "node scripts/test-liberacao-segura-op.cjs",
    "test:venda-instalacao": "node scripts/test-venda-instalacao-producao.cjs",
    "test:encerramento-obra": "node scripts/test-encerramento-obra-guard.cjs",
    "test:venda-obra": "node scripts/test-venda-obra-vinculo.cjs",
    "test:supabase-history": "node scripts/test-supabase-historico-versoes.cjs",
    "test:supabase-applied": "node scripts/test-supabase-conteudo-aplicado.cjs",
    "test:supabase-exact": "node scripts/test-supabase-formatacao-conciliada.cjs",
    "test:supabase-hashes": "node scripts/test-supabase-remote-hashes.cjs --self-test && node scripts/test-supabase-terminadores-historicos.cjs",
    "postinstall": "node scripts/patch-baileys-pairing.mjs",
    "whatsapp:gateway": "node scripts/whatsapp-gateway.mjs",
    "test:supabase-terminadores": "node scripts/test-supabase-terminadores-historicos.cjs",
    "test:cliente360-permissoes": "node scripts/test-cliente360-permissoes.cjs",
    "test:ia-relatorios": "node scripts/test-ia-relatorios-permissoes.cjs",
    "test:marketing": "node scripts/test-marketing-inteligente.mjs && node scripts/test-marketing-backend.mjs && node scripts/test-marketing-midias.mjs && node scripts/test-marketing-upload-direto.mjs",
    "test:wvetro-validacao-item": "node scripts/test-wvetro-validacao-item.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@supabase/supabase-js": "^2.43.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.0",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
